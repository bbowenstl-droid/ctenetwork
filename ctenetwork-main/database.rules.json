{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === 'PASTE_DEVICE_ID'"
      }
    },
    "book": {
      "$season": {
        ".read": "auth != null && auth.uid === 'PASTE_DEVICE_ID'",
        "pins": {
          "$owner": {
            ".write": "auth != null && auth.uid === 'PASTE_DEVICE_ID'",
            ".validate": "newData.isString() && newData.val().length === 64"
          }
        },
        "links": {
          "$owner": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isString() && root.child('book').child($season).child('pins').child($owner).exists() && newData.val() === root.child('book').child($season).child('pins').child($owner).val()"
            }
          }
        },
        "weeks": {
          "$week": {
            "lockAt": {
              ".read": "auth != null",
              ".write": "auth != null && auth.uid === 'PASTE_DEVICE_ID'",
              ".validate": "newData.isNumber()"
            },
            "status": {
              ".read": "auth != null",
              "$owner": {
                ".write": "auth != null && (auth.uid === 'PASTE_DEVICE_ID' || (root.child('book').child($season).child('pins').child($owner).exists() && root.child('book').child($season).child('links').child($owner).child(auth.uid).val() === root.child('book').child($season).child('pins').child($owner).val() && root.child('book').child($season).child('weeks').child($week).child('lockAt').isNumber() && now < root.child('book').child($season).child('weeks').child($week).child('lockAt').val()))"
              }
            },
            "cards": {
              ".read": "auth != null && root.child('book').child($season).child('weeks').child($week).child('lockAt').isNumber() && now > root.child('book').child($season).child('weeks').child($week).child('lockAt').val()",
              "$owner": {
                ".read": "auth != null && root.child('book').child($season).child('pins').child($owner).exists() && root.child('book').child($season).child('links').child($owner).child(auth.uid).val() === root.child('book').child($season).child('pins').child($owner).val()",
                ".write": "auth != null && (auth.uid === 'PASTE_DEVICE_ID' || (root.child('book').child($season).child('pins').child($owner).exists() && root.child('book').child($season).child('links').child($owner).child(auth.uid).val() === root.child('book').child($season).child('pins').child($owner).val() && root.child('book').child($season).child('weeks').child($week).child('lockAt').isNumber() && now < root.child('book').child($season).child('weeks').child($week).child('lockAt').val()))",
                ".validate": "newData.hasChildren(['ids', 'lockedAt'])"
              }
            },
            "parlays": {
              ".read": "auth != null && root.child('book').child($season).child('weeks').child($week).child('lockAt').isNumber() && now > root.child('book').child($season).child('weeks').child($week).child('lockAt').val()",
              "$owner": {
                ".read": "auth != null && root.child('book').child($season).child('pins').child($owner).exists() && root.child('book').child($season).child('links').child($owner).child(auth.uid).val() === root.child('book').child($season).child('pins').child($owner).val()",
                ".write": "auth != null && (auth.uid === 'PASTE_DEVICE_ID' || (root.child('book').child($season).child('pins').child($owner).exists() && root.child('book').child($season).child('links').child($owner).child(auth.uid).val() === root.child('book').child($season).child('pins').child($owner).val() && root.child('book').child($season).child('weeks').child($week).child('lockAt').isNumber() && now < root.child('book').child($season).child('weeks').child($week).child('lockAt').val()))",
                ".validate": "newData.hasChildren(['ids', 'lockedAt'])"
              }
            }
          }
        }
      }
    }
  }
}
